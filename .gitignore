# GitHub Actions workflows are public CI; everything else under .github/
# (e.g. local tooling hooks) stays maintainer-local. Directory ignores cannot
# be re-included below (same trap as /tools/), hence .github/* + negation.
.github/*
!.github/workflows/
local/

# Claude
.claude/
CLAUDE.md

#Website - different repo
/lindblad-page/

# Maintainer-local tooling (version bump script, etc.). EXCEPTION:
# bench_report.py is PUBLIC — docs/BuildAndTest.md, the generated
# docs/Benchmarks.md, and the committed tests/tools/test_bench_report.py all
# reference it, so it must ship (R.1.14.0/R.1.14.1 gitignored it by mistake;
# see the R.1.15.0 CHANGELOG entry). Directory ignores cannot be re-included
# below, hence /tools/* + negation instead of /tools/.
# Second exception, same reason: check_line_endings.py enforces the LF policy
# that .gitattributes states, and both the CI hygiene job and the committed
# tests/tools/test_line_endings.py run it, so a clone without it fails its own
# suite.
/tools/*
!/tools/bench_report.py
!/tools/check_line_endings.py

# Comparison-benchmark working outputs (repo root during a run; archive to
# local/outputs/ with a date prefix afterwards)
/lb_*.json
/aer_results.json
/aer_trans.json
/aer_combined.json
/aer_validation.json
/lindblad_validation.json

